            "XFree86-1.1",
            "xinetd",
            "xkeyboard-config-Zinoviev",
            "xlock",
            "Xnet",
            "xpp",
            "XSkat",
            "xzoom",
            "YPL-1.0",
            "YPL-1.1",
            "Zed",
            "Zeeff",
            "Zend-2.0",
            "Zimbra-1.3",
            "Zimbra-1.4",
            "Zlib",
            "zlib-acknowledgement",
            "ZPL-1.1",
            "ZPL-2.0",
            "ZPL-2.1"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\(?[A-Za-z0-9.+-]+( (AND|OR|WITH) \\(?[A-Za-z0-9.+-]+\\)?)+$",
          "description": "An SPDX license expression."
        }
      ],
      "examples": [
        "MIT",
        "Apache-2.0",
        "GPL-3.0-or-later",
        "MIT OR Apache-2.0"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "The project's home page, for published POMs."
    },
    "java": {
      "type": [
        "string",
        "integer"
      ],
      "description": "The JDK the project builds and runs with, installed when it is missing: a major version, a distribution with a version, or an exact version.",
      "examples": [
        "21",
        "temurin-21",
        "graalvm-21",
        "zulu-17",
        "corretto-21",
        "21.0.5"
      ]
    },
    "target": {
      "type": [
        "string",
        "integer"
      ],
      "description": "The bytecode level (javac --release). Defaults to the major version of \"java\".",
      "examples": [
        "17",
        "11",
        "8"
      ]
    },
    "main": {
      "description": "The class `jpm start` runs, or several named entry points (`jpm start <name>`).",
      "oneOf": [
        {
          "$ref": "#/definitions/className"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/definitions/className"
          },
          "examples": [
            {
              "cli": "com.example.Cli",
              "server": "com.example.Server"
            }
          ]
        }
      ]
    },
    "runtime": {
      "description": "Dependencies needed to compile and run: on the compile classpath and shipped with the project.",
      "$ref": "#/definitions/dependencies"
    },
    "dev": {
      "description": "Compile-time-only dependencies, never shipped: annotation processors, compile-only APIs (Maven's provided).",
      "$ref": "#/definitions/devOnlyDependencies"
    },
    "test": {
      "description": "Dependencies for the tests only.",
      "$ref": "#/definitions/testDependencies"
    },
    "define": {
      "type": "object",
      "description": "Build-time constants, generated as a class (BuildConfig) next to the main class. Keys with a colon give values for the defines a dependency declares.",
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": {
          "$ref": "#/definitions/define"
        },
        ":": {
          "type": "object",
          "description": "Values for the defines declared by this dependency.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "defineClass": {
      "$ref": "#/definitions/className",
      "description": "The fully qualified name of the generated defines class. Defaults to BuildConfig in the main class's package."
    },
    "scripts": {
      "type": "object",
      "description": "Commands run with `jpm run <name>`: a .java file (run with the project's classpath), a .sh file, or any shell command. An object gives a script dependencies of its own, resolved apart from the project's, or makes it a code generator (\"generates\").",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "run"
            ],
            "additionalProperties": false,
            "properties": {
              "run": {
                "type": "string",
                "description": "The .java file, .sh file or shell command."
              },
              "dependencies": {
                "type": "object",
                "description": "Maven dependencies of a .java script, on its classpath before the module's; other scripts get them in JPM_SCRIPT_CLASSPATH. They are resolved on their own and never change the project's versions.",
                "propertyNames": {
                  "$ref": "#/definitions/dependencyKey"
                },
                "additionalProperties": {
                  "$ref": "#/definitions/versionSpec"
                }
              },
              "generates": {
                "enum": ["sources", "resources"],
                "description": "Makes the script a code generator: before compiling, jpm runs it into a folder of its own (JPM_GENERATED) when its inputs or its definition changed, and adds that folder to the module's sources or resources."
              },
              "inputs": {
                "type": "array",
                "description": "Files and folders, relative to the module, whose changes make a generator run again.",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "examples": [
        {
          "format": "scripts/format.sh",
          "generate": {
            "run": "scripts/Generate.java",
            "dependencies": {
              "com.google.code.gson:gson": "2.11.0"
            }
          }
        }
      ]
    },
    "hooks": {
      "type": "object",
      "description": "Scripts to run before or after build, test, install or start; \":<profile>\" limits a hook to a profile (`jpm build --release` is profile release).",
      "patternProperties": {
        "^(pre|post)(build|test|install|start)(:[A-Za-z0-9_-]+)?$": {
          "type": "string",
          "description": "The name of a script from \"scripts\"."
        }
      },
      "propertyNames": {
        "pattern": "^(pre|post)(build|test|install|start)(:[A-Za-z0-9_-]+)?$"
      },
      "additionalProperties": false,
      "examples": [
        {
          "prebuild": "generate",
          "postbuild:release": "upload-mappings"
        }
      ]
    },
    "patches": {
      "type": "object",
      "description": "Patch files applied to the sources of a dependency, which is then rebuilt: dependency key to the path of a .patch file, or to an object with the file and options.",
      "propertyNames": {
        "$ref": "#/definitions/dependencyKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "file"
            ],
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "description": "The .patch file."
              },
              "dependencies": {
                "type": "object",
                "description": "Compile-only dependencies of the patched classes, resolved with the project; never added to anyone's runtime classpath.",
                "propertyNames": {
                  "$ref": "#/definitions/dependencyKey"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "release": {
                "type": "integer",
                "minimum": 8,
                "description": "Java version to compile the patched classes for; default: the library's own bytecode level. Not lower than it."
              }
            }
          }
        ]
      }
    },
    "workspace": {
      "type": "array",
      "description": "The folders of the workspace's modules, each with its own project.jsonc. A workspace root lists modules only.",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "isolated": {
      "type": "boolean",
      "default": false,
      "description": "A workspace module resolved in a graph of its own (its own section of project.lock): its dependencies never change the versions other modules get. Meant for tooling and code generators; no module can depend on it, and it cannot depend on workspace modules."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Source folders of the module, relative to it, replacing the layout's: e.g. [\"src/main/java\", \"src/generated/java\"]."
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Resource folders of the module, relative to it, replacing the layout's. Earlier folders win when two hold the same file."
    },
    "visibility": {
      "enum": [
        "public",
        "internal"
      ],
      "default": "public",
      "description": "public modules are published; internal modules are not, and bundles isolate them in their own class loader."
    },
    "repositories": {
      "type": "array",
      "description": "Maven repositories to search besides Maven Central (https:// or file:// URLs).",
      "items": {
        "type": "string",
        "pattern": "^(https?|file):"
      },
      "uniqueItems": true
    },
    "javacArgs": {
      "type": "array",
      "description": "Extra arguments for javac.",
      "items": {
        "type": "string"
      }
    },
    "nativeArgs": {
      "type": "array",
      "description": "Extra arguments for GraalVM native-image (`jpm build --native`).",
      "items": {
        "type": "string"
      }
    },
    "testJvmArgs": {
      "type": "array",
      "description": "Options for the JVM running the tests, e.g. [\"-Xmx2g\", \"--add-opens=java.base/java.lang=ALL-UNNAMED\"]. A workspace module's come after the root's.",
      "items": {
        "type": "string"
      }
    },
    "groovy": {
      "description": "The module has Groovy sources (.groovy, in the source folders; src/main/groovy and src/test/groovy in the maven layout): groovyc of this version compiles them before javac, jointly with the Java sources. The runtime library (org.apache.groovy:groovy for Groovy 4 and later, org.codehaus.groovy:groovy before) is an ordinary dependency. Workspace modules inherit it from the root.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$",
      "examples": [
        "4.0.24"
      ]
    },
    "scala": {
      "description": "The module has Scala sources (.scala, in the source folders; src/main/scala and src/test/scala in the maven layout): the Scala compiler of this version (2.13 or 3) compiles them before javac, seeing the Java sources. The runtime library (org.scala-lang:scala3-library_3 for Scala 3, org.scala-lang:scala-library for 2.13) is an ordinary dependency. Workspace modules inherit it from the root.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$",
      "examples": [
        "3.5.2"
      ]
    },
    "kotlin": {
      "description": "The module has Kotlin sources: kotlinc of this version compiles them (before javac, seeing the Java sources). In the maven layout, src/main/kotlin and src/test/kotlin are source folders too. The standard library, org.jetbrains.kotlin:kotlin-stdlib, is an ordinary dependency. Workspace modules inherit it from the root.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$",
          "examples": [
            "2.2.20"
          ]
        },
        {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+([-.][0-9A-Za-z.-]+)?$",
              "description": "The Kotlin version, exact, such as 2.2.20."
            },
            "plugins": {
              "type": "array",
              "description": "Compiler plugins: group:artifact (the Kotlin version) or group:artifact:version, or the short name of one of Kotlin's own (assignment, sam-with-receiver, allopen, noarg, serialization, lombok, power-assert, parcelize, atomicfu, js-plain-objects, compose). Their options go in args as -P plugin:<id>:<option>=<value>.",
              "items": {
                "type": "string"
              }
            },
            "args": {
              "type": "array",
              "description": "Extra arguments for kotlinc, e.g. -Xjsr305=strict; -J entries go to the JVM running it, e.g. -J-Xmx2g.",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "exclude": {
      "type": "array",
      "description": "Packages left out of everything the runtime and dev dependencies bring in, like an exclusion on each of them (Gradle's configurations.all { exclude(...) }), e.g. for what the platform provides: group:artifact, group:* or group. Test dependencies are not affected. A workspace module adds its own to the root's.",
      "items": {
        "type": "string",
        "pattern": "^[^:\\s]+(:[^:\\s]+)?$"
      },
      "uniqueItems": true
    },
    "filter": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Resources (globs relative to the resource folder, e.g. \"*.properties\") copied with each ${name} replaced. Values, later ones winning: the module's NAME and VERSION; fields of the workspace root's project.jsonc, then the module's (nested ones dotted, e.g. ${extensions.publish.repo}); *.properties next to the root's project.jsonc, then next to the module's; then the module's define values."
    },
    "relocate": {
      "type": "object",
      "description": "Packages moved to new names in the flat bundle (like Shadow's relocation): package to new package, e.g. {\"org.yaml.snakeyaml\": \"com.example.shaded.snakeyaml\"}. Classes, descriptors, string constants naming classes, and service files are rewritten.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layout": {
      "enum": [
        "jpm",
        "maven",
        "gradle"
      ],
      "default": "jpm",
      "description": "Where sources live. jpm: src/, src/assets/, test/, test/assets/. maven (or gradle): src/main/java, src/main/resources, src/test/java, src/test/resources."
    },
    "package": {
      "enum": [
        "jar",
        "bundle"
      ],
      "default": "jar",
      "description": "What `jpm build` produces: a jar, or a bundle with the runtime dependencies (a runnable jar-in-jar with internal modules isolated when there is a main, one flat jar when there is none, as plugins need)."
    },
    "extensions": {
      "type": "object",
      "description": "The extensions this project uses and their settings. A dependency key (with a colon) declares an extension with its version, in the workspace root only; jpm pins it in project.lock and runs it as `jpm <name>`, where <name> is its artifact without the jpm- prefix. A plain name holds that extension's settings, which jpm passes through untouched.",
      "examples": [
        {
          "github:java-package-manager/jpm-publish": "^0.2",
          "publish": {
            "javadoc": true
          }
        }
      ],
      "properties": {
        "publish": {
          "$ref": "#/definitions/publish"
        }
      },
      "patternProperties": {
        ":": {
          "type": "string",
          "description": "The extension's version: a range or tag for Git (^1.0, #main), a range or version for Maven."
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "extension": {
      "type": "object",
      "description": "Marks this project as a jpm extension, so `jpm add` declares it in \"extensions\" instead of adding it as a dependency, and describes what it adds; jpm serves the description to IDEs (extensions/list) without running the extension.",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "description": "What the extension does." },
        "commands": {
          "type": "object",
          "description": "Its commands, by what follows `jpm` (\"publish\", or \"format check\" for a subcommand); each starts with the extension's name without the jpm- prefix.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "description": "What the command does, shown in IDEs and in `jpm help`." },
              "options": {
                "type": "object",
                "description": "Options by name (\"--dry-run\").",
                "propertyNames": { "pattern": "^-" },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "argument": { "type": "string", "description": "The name of the option's value; leave it out for a flag." },
                    "description": { "type": "string", "description": "What the option does." }
                  }
                }
              }
            }
          }
        },
        "checks": {
          "type": "object",
          "description": "Checks it adds to `jpm check`, by id.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": { "type": "string", "description": "What the check checks, shown in `jpm check`'s output." },
              "run": {
                "type": "array",
                "items": { "type": "string" },
                "description": "The arguments `jpm check` runs the extension with (default: check <id>). A non-zero exit fails the check; problems the extension writes to the file in JPM_CHECK_PROBLEMS (a JSON array of {severity, message, file?, line?, hint?}) are reported with their locations."
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "className": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(\\.[A-Za-z_$][A-Za-z0-9_$]*)*$",
      "description": "A fully qualified class name.",
      "examples": [
        "com.example.App"
      ]
    },
    "dependencyKey": {
      "type": "string",
      "description": "group:artifact (Maven), group:artifact:classifier, github:user/repo[/module] (also gitlab: and codeberg:), workspace:<module>, ext:<extension>/<name> (provided by the extension jpm-<extension>, e.g. ext:paperweight/server), or gradle:api (the Gradle API of a Gradle distribution; the version is the Gradle version, e.g. 9.8.0).",
      "anyOf": [
        {
          "pattern": "^[^:/\\s]+:[^:/\\s]+(:[^:/\\s]+)?$"
        },
        {
          "pattern": "^(github|gitlab|codeberg):[^/:\\s]+/[^/:\\s]+(/[^:\\s]+)?$"
        },
        {
          "pattern": "^workspace:[^:/\\s]+$"
        },
        {
          "const": "gradle:api"
        },
        {
          "pattern": "^ext:[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9._-]*$"
        }
      ]
    },
    "versionSpec": {
      "type": "string",
      "description": "A version or range, in Maven, Gradle or npm syntax: exact (1.2.3, =1.2.3, 1.2.3!!), Maven ranges ([1.0,2.0), [1.5,), (,1.0], (,1.0],[1.2,)), Gradle ranges and prefixes (]1.0,2.0[, 1.+, 1.2.+, +), npm ranges (^1.2, ~1.2.3, ~1, >=0.1, >1.0 <=2.0, 1.x, 1.2.*, *, 1.0 - 2.0, ^1 || ^2), the newest of a kind (latest.release, RELEASE, latest.milestone, latest.integration, LATEST) or a strict range with a preferred version ([1.0,2.0)!!1.5). Git dependencies also take a tag, a commit or #branch, and read a bare 1.2 as 1.2.x; workspace modules take *.",
      "examples": [
        "1.2.3",
        "^1.2",
        "~1",
        "1.+",
        "[1.0,2.0)",
        ">=0.1",
        "1.x",
        "latest.release",
        "*"
      ]
    },
    "dependencyOptions": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/definitions/versionSpec"
        },
        "exclude": {
          "type": "array",
          "description": "Transitive dependencies to leave out: group:artifact, group:* or group.",
          "items": {
            "type": "string",
            "pattern": "^[^:\\s]+(:[^:\\s]+)?$"
          },
          "uniqueItems": true
        }
      }
    },
    "runtimeDependencyOptions": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/definitions/versionSpec"
        },
        "exclude": {
          "type": "array",
          "description": "Transitive dependencies to leave out: group:artifact, group:* or group.",
          "items": {
            "type": "string",
            "pattern": "^[^:\\s]+(:[^:\\s]+)?$"
          },
          "uniqueItems": true
        },
        "runtimeOnly": {
          "type": "boolean",
          "description": "Only on the runtime classpath, not the compile classpath (Maven's runtime scope)."
        }
      }
    },
    "devDependencyOptions": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/definitions/versionSpec"
        },
        "exclude": {
          "type": "array",
          "description": "Transitive dependencies to leave out: group:artifact, group:* or group.",
          "items": {
            "type": "string",
            "pattern": "^[^:\\s]+(:[^:\\s]+)?$"
          },
          "uniqueItems": true
        },
        "api": {
          "type": "boolean",
          "default": false,
          "description": "Pass this dependency on to consumers' compile classpaths (Gradle's compileOnlyApi): modules and projects that depend on this one compile against it too. It is never on a runtime classpath or in a bundle; the platform provides it."
        }
      }
    },
    "testDependencyOptions": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/definitions/versionSpec"
        },
        "exclude": {
          "type": "array",
          "description": "Transitive dependencies to leave out: group:artifact, group:* or group.",
          "items": {
            "type": "string",
            "pattern": "^[^:\\s]+(:[^:\\s]+)?$"
          },
          "uniqueItems": true
        },
        "tests": {
          "type": "boolean",
          "default": false,
          "description": "For a workspace:<module> dependency: its compiled tests too (Gradle's test fixtures), so these tests can use its test base classes and helpers. Its tests are not run here."
        }
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dependencyKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/versionSpec"
          },
          {
            "$ref": "#/definitions/runtimeDependencyOptions"
          }
        ]
      }
    },
    "devOnlyDependencies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dependencyKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/versionSpec"
          },
          {
            "$ref": "#/definitions/devDependencyOptions"
          }
        ]
      }
    },
    "devDependencies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dependencyKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/versionSpec"
          },
          {
            "$ref": "#/definitions/dependencyOptions"
          }
        ]
      }
    },
    "testDependencies": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/dependencyKey"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/versionSpec"
          },
          {
            "$ref": "#/definitions/testDependencyOptions"
          }
        ]
      }
    },
    "define": {
      "oneOf": [
        {
          "type": [
            "string",
            "integer",
            "boolean"
          ],
          "description": "A constant: its type is that of the value."
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "description": "The type of the constant in the defines class.",
              "enum": [
                "string",
                "int",
                "boolean"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ],
              "description": "The value, unless the environment variable \"env\" is set."
            },
            "env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "The environment variable (or .env file entry) the value comes from."
            },
            "default": {
              "type": [
                "string",
                "integer",
                "boolean"
              ],
              "description": "The value when neither \"value\" nor \"env\" gives one. A library may leave all three out: its consumers then must provide it."
            }
          }
        }
      ]
    },
    "publish": {
      "type": "object",
      "description": "Settings for `jpm publish` (the jpm-publish extension). A module's settings override the workspace root's key by key.",
      "additionalProperties": false,
      "properties": {
        "repositories": {
          "type": "object",
          "description": "Repositories by name; `jpm publish <name>` publishes to one. Credentials come from JPM_PUBLISH_<NAME>_USERNAME and _PASSWORD.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https?|file):",
                "description": "Where release versions go."
              },
              "snapshots": {
                "type": "string",
                "pattern": "^(https?|file):",
                "description": "Where -SNAPSHOT versions go."
              },
              "type": {
                "enum": [
                  "maven",
                  "central"
                ],
                "default": "maven",
                "description": "central publishes to Maven Central through the Sonatype Central Portal."
              },
              "publishingType": {
                "enum": [
                  "automatic",
                  "user_managed"
                ],
                "default": "automatic",
                "description": "Maven Central: publish once validated, or wait for a release in the Portal."
              }
            }
          }
        },
        "developers": {
          "type": "array",
          "description": "Required by Maven Central.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "The developer's id, such as their user name."
              },
              "name": {
                "type": "string",
                "description": "The developer's name."
              },
              "email": {
                "type": "string",
                "description": "The developer's email address."
              },
              "url": {
                "type": "string",
                "description": "The developer's web page."
              },
              "organization": {
                "type": "string",
                "description": "The developer's organization."
              }
            }
          }
        },
        "scm": {
          "type": "string",
          "description": "The source repository's URL. Defaults to \"url\" on GitHub, GitLab and Codeberg."
        },
        "javadoc": {
          "type": "boolean",
          "description": "Publish a javadoc jar to repositories other than Maven Central too."
        },
        "sign": {
          "type": "boolean",
          "description": "Sign with gpg. Defaults to true for Maven Central only."
        },
        "skip": {
          "type": "boolean",
          "description": "Do not publish this module."
        }
      }
    }
  }
}
