    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "The project's name. It is the jar's name and, with \"group\", its Maven artifact id."
    },
    "version": {
      "type": "string",
      "description": "The project's version, e.g. 1.2.0 or 1.3.0-SNAPSHOT.",
      "examples": [
        "0.1.0"
      ]
    },
    "group": {
      "type": "string",
      "description": "The Maven group id, needed to publish.",
      "examples": [
        "com.example"
      ]
    },
    "description": {
      "type": "string",
      "description": "What the project is, for published POMs."
    },
