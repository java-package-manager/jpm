// jpm builds itself: `./bootstrap.sh` once, then `bin/jpm build`, `bin/jpm test` and `bin/jpm build --native`.
{
  "$schema": "./cli/src/assets/dev/jpm/project.schema.json",
  "name": "jpm-workspace",
  "version": "0.12.1",
  "group": "dev.jpm",
  "license": "MIT",
  "java": "21",
  // api: the public API, published as dev.jpm:jpm-api; cli: jpm itself
  "workspace": ["api", "cli"],
  "url": "https://github.com/java-package-manager/jpm",
  "extensions": {
    "github:java-package-manager/jpm-publish": "^0.3",
    "publish": {
      "repositories": {
        // CI publishes every release here: `jpm publish thenextlvl`
        "thenextlvl": { "url": "https://repo.thenextlvl.net/releases" }
      },
      "javadoc": true
    },
    "github:java-package-manager/jpm-changeset": "^0.2.0"
  }
}
