// jpm builds itself: `./bootstrap.sh` once, then `bin/jpm build`, `bin/jpm test` and `bin/jpm build --native`.
{
  "$schema": "./cli/src/assets/dev/jpm/project.schema.json",
  "name": "jpm-workspace",
  "version": "0.11.0",
  "group": "dev.jpm",
  "license": "MIT",
  "java": "21",
  // api: the public API, published as dev.jpm:jpm-api; cli: jpm itself
  "workspace": ["api", "cli"],
  "url": "https://github.com/java-package-manager/jpm",
  "extensions": {
    "publish": {
      "repositories": {
        // CI publishes releases and snapshots of main here: `jpm publish thenextlvl`
        "thenextlvl": {
          "url": "https://repo.thenextlvl.net/releases",
          "snapshots": "https://repo.thenextlvl.net/snapshots"
        }
      },
      "javadoc": true
    }
  }
}
