{
  "name": "jpm-lint",
  "version": "1.4.0",
  "main": "com.example.lint.Main",
  "extension": {
    "description": "Lints the sources",
    "commands": {
      "lint": {
        "description": "Lint every module",
        "options": { "--fix": { "description": "Fix what can be fixed" }, "--module": { "argument": "name" } }
      }
    },
    "checks": { "style": { "description": "The code follows the style" } }
  }
}
