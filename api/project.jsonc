// The public API of jpm: dev.jpm.api only, with full Javadoc. Tools depend on it as
// "github:java-package-manager/jpm/api"; it is not published to Maven repositories.
{
  "name": "api",
  "visibility": "public",
  // the build fails on missing or broken Javadoc of anything public
  "javacArgs": ["-Xdoclint:all/protected", "-Werror"],
  "test": {
    "org.junit.jupiter:junit-jupiter": "[6.0.0,)"
  }
}
